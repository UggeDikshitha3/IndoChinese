# ==========================================
# RUNTIME & ENVIRONMENT CONFIGURATION
# ==========================================
NODE_ENV=
PORT=

# ==========================================
# RESTAURANT IDENTITY & CONTACT (NAP)
# If left empty, defaults to built-in restaurant config
# ==========================================
RESTAURANT_NAME=
RESTAURANT_TAGLINE=
RESTAURANT_DESCRIPTION=
RESTAURANT_ADDRESS=
RESTAURANT_CITY=
RESTAURANT_POSTCODE=
RESTAURANT_PHONE=
RESTAURANT_EMAIL=
RESTAURANT_WHATSAPP=
RESTAURANT_LATITUDE=
RESTAURANT_LONGITUDE=

# ==========================================
# SOCIAL & EXTERNAL INTEGRATION LINKS
# ==========================================
GOOGLE_MAPS_URL=
GOOGLE_BUSINESS_PROFILE_URL=
INSTAGRAM_URL=
FACEBOOK_URL=
TIKTOK_URL=

# ==========================================
# AUTHENTICATION & SECURITY SECRETS
# ==========================================
JWT_SECRET=
JWT_EXPIRE_MINUTES=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ==========================================
# APPLICATION & HOSTING URLS
# ==========================================
APP_URL=
FRONTEND_URL=
BACKEND_URL=
VITE_API_URL=

# ==========================================
# DATABASE & STORAGE (OPTIONAL)
# ==========================================
DATABASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# EMAIL / SMTP NOTIFICATIONS (OPTIONAL)
# ==========================================
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ==========================================
# AI CAPABILITIES (OPTIONAL)
# ==========================================
GEMINI_API_KEY=
